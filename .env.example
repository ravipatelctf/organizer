# apps/api/.env — copy this file there and fill in real values.
# DATABASE_URL is the Neon pooled connection string (used at runtime via the driver adapter).
# DIRECT_URL is the same host with "-pooler" removed (used by Prisma migrations and seed).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -hex 64
AT_SECRET=
RT_SECRET=

PORT=8000

# apps/web — empty locally, "/api" on Vercel behind the rewrite
NEXT_PUBLIC_API_BASE_PATH=
