datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ── PLATFORM ────────────────────────────────────────────────
model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique @db.VarChar(255)
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  firstName              String    @map("first_name") @db.VarChar(100)
  lastName               String    @map("last_name") @db.VarChar(100)
  avatarUrl              String?   @map("avatar_url") @db.VarChar(500)
  isSuperAdmin           Boolean   @default(false) @map("is_super_admin")
  resetPasswordTokenHash String?   @unique @map("reset_password_token_hash") @db.VarChar(255)
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at") @db.Timestamp(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamp(6)

  memberships OrgMembership[] @relation("UserMemberships")
  sessions    Session[]
  // audit back-relations added as their models arrive: invitedMemberships,
  // createdProjects, updatedProjects, createdTasks, updatedTasks, assignedRoles

  @@map("users")
}

// ── TENANT ──────────────────────────────────────────────────
model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(63) // the /orgs/:slug segment
  settings    Json      @default("{}") @db.JsonB
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(6)

  memberships    OrgMembership[]
  roles          Role[]
  sessions       Session[]
  projects       Project[]
  projectMembers ProjectMember[]
  tasks          Task[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model OrgMembership {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  status              String    @default("INVITED") @db.VarChar(20) // INVITED|ACTIVE|SUSPENDED|REMOVED
  joinedAt            DateTime? @map("joined_at") @db.Timestamp(6)
  lastActiveAt        DateTime? @map("last_active_at") @db.Timestamp(6)
  invitedById         String?   @map("invited_by") @db.Uuid
  invitationTokenHash String?   @unique @map("invitation_token_hash") @db.VarChar(255)
  invitationExpiresAt DateTime? @map("invitation_expires_at") @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  roles              MembershipRole[]
  projectMemberships ProjectMember[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_memberships")
}

// ── RBAC (per-org, seeded from the permission registry) ─────
model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  rank           Int // 1 = highest privilege
  isOrgAdmin     Boolean   @default(false) @map("is_org_admin") // ← access level 2
  isSystemRole   Boolean   @default(false) @map("is_system_role") // seeded, undeletable
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.VarChar(100) // e.g. "view-own-projects"
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id              String   @id @default(uuid()) @db.Uuid
  orgMembershipId String   @map("org_membership_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  assignedById    String?  @map("assigned_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  membership OrgMembership @relation(fields: [orgMembershipId], references: [id], onDelete: Cascade)
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([orgMembershipId, roleId])
  @@map("membership_roles")
}

// ── PROJECTS (isolation boundary #2) ────────────────────────
model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String    @db.VarChar(10) // "APOLLO" → task refs APOLLO-14
  name           String    @db.VarChar(150)
  description    String?   @db.Text
  status         String    @default("ACTIVE") @db.VarChar(20) // ACTIVE|ARCHIVED|COMPLETED
  taskSequence   Int       @default(0) @map("task_sequence") // per-project task counter
  startDate      DateTime? @map("start_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  tasks        Task[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid // denormalized — see note
  projectId       String    @map("project_id") @db.Uuid
  orgMembershipId String    @map("org_membership_id") @db.Uuid
  role            String    @default("CONTRIBUTOR") @db.VarChar(20) // LEAD|CONTRIBUTOR|VIEWER
  addedById       String?   @map("added_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership    OrgMembership @relation(fields: [orgMembershipId], references: [id], onDelete: Cascade)
  assignedTasks Task[]        @relation("TaskAssignee")

  @@unique([projectId, orgMembershipId])
  @@index([organizationId, orgMembershipId]) // ← powers the member-visibility filter
  @@map("project_members")
}

// ── TASKS — isolation is transitive through the project ─────
model Task {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid // denormalized — see ProjectMember note
  projectId      String    @map("project_id") @db.Uuid
  number         Int // per-project sequential, from Project.taskSequence — APOLLO-14
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  status         String    @default("TODO") @db.VarChar(20) // TODO|IN_PROGRESS|IN_REVIEW|DONE
  priority       String    @default("MEDIUM") @db.VarChar(20) // LOW|MEDIUM|HIGH|URGENT
  assigneeId     String?   @map("assignee_id") @db.Uuid // → ProjectMember, not User
  dueDate        DateTime? @map("due_date") @db.Date
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     ProjectMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([organizationId, projectId, status])
  @@map("tasks")
}

// ── SESSIONS & AUDIT ────────────────────────────────────────
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  token          String   @unique @db.VarChar(255) // opaque refresh token
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // null = account-level session
  expiresAt      DateTime @map("expires_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // null = platform-level action
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(100) // "project.create", "member.suspend"
  resourceType   String   @map("resource_type") @db.VarChar(50)
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json     @default("{}") @db.JsonB
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
