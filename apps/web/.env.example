# apps/web/.env — copy this file there.
# A full origin (http://localhost:8000) locally: lib/env.ts uses it as-is, so the api runs on
# its own origin and is called directly. Set to "/api" on Vercel, where apps/web/vercel.ts
# rewrites /api/* to the api project so the two are same-origin — lib/env.ts resolves a bare
# path like that against the current origin instead.
NEXT_PUBLIC_API_BASE_PATH=http://localhost:8000
